# Template for the project's per-directory environment. Copy to `.envrc`
# (which is gitignored), fill in real values, and run `direnv allow`.
#
#   cp .envrc.example .envrc
#   $EDITOR .envrc
#   direnv allow

# Anthropic Messages API. Used when `make run LLM=anthropic ...` or
# `minerva ... --llm anthropic`. Get one from
# https://console.anthropic.com/settings/keys
export ANTHROPIC_API_KEY=sk-ant-api03-replace-me

# OpenAI (optional — only needed for `--llm openai`).
# export OPENAI_API_KEY=sk-...

# Default LLM + model so `make run` doesn't need flags. Optional.
# export LLM=anthropic
# export LLM_MODEL=claude-sonnet-5-5

# This repo lives at github.com/kylemichaelreaves/minerva — pin the gh CLI
# to the personal account *for this directory only*. GH_TOKEN takes
# precedence over gh's global active account, and direnv unsets it on
# leaving the repo, so this never bleeds into work repos (unlike a
# `gh auth switch`, which mutates global state and never switches back).
# The token is read from gh's keyring at load time, so re-auths are
# picked up automatically.
if command -v gh >/dev/null 2>&1; then
  GH_TOKEN="$(gh auth token -h github.com -u kylemichaelreaves 2>/dev/null)" || true
  if [ -n "${GH_TOKEN:-}" ]; then
    export GH_TOKEN
  else
    unset GH_TOKEN
    echo "warning: no gh keyring token for kylemichaelreaves; run: gh auth login" >&2
  fi
fi
