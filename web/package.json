{
  "name": "minerva-web",
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=11.12.1"
  },
  "packageManager": "npm@11.12.1",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --exclude 'tests/e2e/**'",
    "test:e2e": "vitest run tests/e2e",
    "test:coverage": "vitest run --exclude 'tests/e2e/**' --coverage",
    "test:browser": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "solid-js": "^1.9.19"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@solidjs/testing-library": "^0.8.10",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-solid": "^0.20.0",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "storybook": "^10.6.3",
    "storybook-solidjs-vite": "10.7.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-solid": "^2.11.16",
    "vitest": "^5.0.2"
  }
}
