# ── Corpus data ────────────────────────────────────────────────────
# Perseus / Wikisource / Gallica / Gutenberg dumps — fetched locally
# by `perseus/download_*.py` scripts, large and reproducible. Pattern
# covers all raw_<source>/ directories (raw_xml, raw_xml_aristotle,
# raw_hegel_de, raw_text_aristotle_ica, raw_xml_aristotle_first1k …)
# without needing one line per author.
perseus/raw_*/

# Derived data: chunks, indexes, embeddings, and the source PDFs for
# Hegel/Kant (Cambridge/OUP editions still under copyright). Rebuilt
# from source by `minerva ingest` after restoring the library tarball.
# Use `data/*` (not `data/`) so `!data/glossary/` can un-ignore curator YAML.
data/*
!data/glossary/
!data/glossary/**
# The author manifest is hand-maintained source-of-truth config (the
# generator derives corpus_registry.py / author_ordering.py / atlasData.ts
# from it, and the codegen-sync tests check against it) — keep it tracked.
!data/authors/
!data/authors/manifest.yaml

# ── Secrets ────────────────────────────────────────────────────────
# .envrc holds API keys; .envrc.example is the committed template
.envrc

# ── Agent scratch ──────────────────────────────────────────────────
# Per-plan working directories for subagent-driven plan execution:
# ledgers, task briefs, review packages. Scratch by construction — the
# git history is the durable record.
.superpowers/

# ── Python ─────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
# pytest-xdist (`pytest -n auto`) writes one shard per worker instead of a
# single `.coverage` file, named `.coverage.<host>.pid<N>.<rand>.<rand>`.
.coverage.*
htmlcov/
coverage.xml

# ── JavaScript / TypeScript ────────────────────────────────────────
# Bare `node_modules/` matches at any depth — covers both
# `web/node_modules/` (the SolidJS app) and a stray root-level
# `node_modules/` that an `npx` invocation can drop in.
node_modules/
web/dist/
web/.vite/

# ── Editors & IDEs ─────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo

# ── Tooling state ──────────────────────────────────────────────────
# Claude Code project state, if any lands in-tree. Project slash commands
# and the project-wide hooks config are the exception: they are checked-in
# prose/config meant to be shared, not local session state, so
# .claude/skills/, .claude/commands/ and .claude/settings.json are carved
# back out (#322). .claude/state/ (hook marker files) stays ignored via the
# blanket rule.
#
# The skills carve-out is load-bearing and was nearly missed: `.claude/*`
# swallowed a whole skill directory silently, so `git status` showed only the
# deletion of the command it replaced. Anything added under .claude/ that is
# meant to be shared needs its own `!` line here.
.claude/*
!.claude/commands/
!.claude/skills/
!.claude/settings.json
.screenshots/
# Transient working screenshots (one-off captures during dev review).
.screenshots-tmp/
# Playwright MCP scratch: accessibility snapshots, console logs and
# screenshots it writes while driving the app for a manual verification.
# Pure run artifacts — regenerated on every session, never reviewed.
.playwright-mcp/
# Playwright test runner artifacts: traces/screenshots on failure and the
# HTML report, both regenerated by every `npm run test:browser` run.
web/test-results/
web/playwright-report/

# ── OS noise ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Logs ───────────────────────────────────────────────────────────
*.log
